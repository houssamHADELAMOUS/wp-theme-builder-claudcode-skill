{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dark",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#121212", "name": "Base" },
				{ "slug": "contrast", "color": "#f5f5f5", "name": "Contrast" },
				{ "slug": "primary", "color": "#8ab4f8", "name": "Primary" },
				{ "slug": "secondary", "color": "#1e1e1e", "name": "Secondary" },
				{ "slug": "accent", "color": "#f28b82", "name": "Accent" },
				{ "slug": "muted", "color": "#b0b3b8", "name": "Muted" }
			]
		},
		"shadow": {
			"presets": [
				{ "slug": "card", "shadow": "0 2px 8px rgba(0, 0, 0, 0.5)", "name": "Card" },
				{ "slug": "raised", "shadow": "0 8px 24px rgba(0, 0, 0, 0.6)", "name": "Raised" }
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				}
			}
		}
	}
}
